# Vercel environment variables for the /api/chat serverless function.
# Set these in Vercel → Project → Settings → Environment Variables
# (or `vercel env add`). Do NOT commit your real key.

# Your Vercel AI Gateway key.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

# Optional: model to use through the gateway (default: openai/gpt-4o-mini).
AI_MODEL=openai/gpt-4o-mini
