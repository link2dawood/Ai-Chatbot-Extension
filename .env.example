# Set these in Vercel → Project → Settings → Environment Variables, then redeploy.
# Configure any one provider, or several. Paste keys exactly: no quotes, no spaces.
# Never place real secrets in extension source files.

# OpenAI — https://platform.openai.com/api-keys (keys start with sk-proj-)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Anthropic — https://console.anthropic.com/settings/keys (keys start with sk-ant-)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional, only for Opus/Sonnet 5+ models (ignored for Haiku): low | medium | high | xhigh | max
ANTHROPIC_EFFORT=

# v0 — https://v0.app (Settings → API Keys). Needs a Premium/Team plan with usage-based billing.
V0_API_KEY=
V0_MODEL=v0-1.5-md

# Which provider "Auto" uses. Falls back to the first configured provider.
AI_PROVIDER=openai

# --- Paid-only access via Polar (https://polar.sh) --------------------------
# POLAR_ENV picks which Polar the server uses: "production" (default) or "sandbox".
# Keep both sets of values in Vercel and flip POLAR_ENV to switch. In sandbox mode the
# POLAR_SANDBOX_* values are used (they fall back to the production ones if unset).
POLAR_ENV=production

# Production (polar.sh). Ids and checkout links are public, not secrets.
# POLAR_ORGANIZATION_ID turns paid-only access ON. Leave it unset to keep the API open.
POLAR_ORGANIZATION_ID=
# Production checkout link. Shown on the extension's "Upgrade to Premium" buttons.
# This works even while POLAR_ORGANIZATION_ID is unset.
POLAR_CHECKOUT_URL=https://buy.polar.sh/polar_cl_gZUWYkEwHKFs47Ljs6KMoBGiBgW7oA6ejoCfy0Toz2Y

# Sandbox (sandbox.polar.sh): a separate organization with its own id.
POLAR_SANDBOX_ORGANIZATION_ID=
POLAR_SANDBOX_CHECKOUT_URL=https://sandbox-api.polar.sh/v1/checkout-links/polar_cl_tkE6w7BNSg4ewDFGFTUYzGoELUncMl7EyHNLT3j1dJl/redirect
