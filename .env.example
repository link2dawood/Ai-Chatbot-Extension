# Set these in Vercel Project Settings > Environment Variables.
# Never place real secrets in extension source files.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# Optional: only for local/deployment tooling if you choose to use v0/Vercel CLI.
# This is not used by the extension at runtime.
V0_TOKEN=your_v0_token_here
