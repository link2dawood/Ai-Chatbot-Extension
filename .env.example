# Vercel environment variables for the /api/chat serverless function.
# Set these in Vercel → Project → Settings → Environment Variables
# (or `vercel env add`). Do NOT commit your real key.

# Your v0 API key (from v0.app → Settings → API Keys).
# Note: the v0 API requires a Premium/Team plan with usage-based billing enabled.
V0_API_KEY=your-v0-api-key

# Optional: model to use (default: v0-1.5-md; also v0-1.5-lg).
AI_MODEL=v0-1.5-md
