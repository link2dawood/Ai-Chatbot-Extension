# --- Plans and limits (change, redeploy, no extension update needed) -----------
FREE_DAILY_LIMIT=10
FREE_IP_DAILY_LIMIT=40
PRO_MONTHLY_LIMIT=500
PRO_PREMIUM_MONTHLY_LIMIT=30
PRO_PLAN_NAME=Premium Access
PRO_PRICE_LABEL=$2/month

# --- Feature switches (on unless set to 0/false/off) ----------------------------
FEATURE_ATTACHMENTS=1
FEATURE_OWN_KEY=1

# --- Asking old extensions to update --------------------------------------------
# Extensions older than this get an "update" message instead of answers.
MIN_EXTENSION_VERSION=
UPDATE_MESSAGE=Please update Smart Chat Assistant to keep using it.
