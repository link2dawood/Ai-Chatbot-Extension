FREE_CHAT_LIMIT=10
# Free chats per IP address per day, a guard against resetting by reinstalling (default 40).
FREE_IP_DAILY_LIMIT=40
# Which provider serves free chats. Default: the first one with a key of deepseek, openai, anthropic.
